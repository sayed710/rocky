# --- Build stage ---
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/ ./packages/

RUN npm ci

# Source revision for the /about page (ADR-0153). Declared after `npm ci` so a new SHA does not
# invalidate the dependency layer. Empty by default: a local `docker build` / `docker compose build`
# embeds no revision and the page says so, rather than claiming one. CI and release pass the exact
# commit with `--build-arg VITE_GIT_SHA=<full sha>`; a malformed value fails `vite build`. Not a
# secret — the commit of a public repository — and it never reaches the runtime stage as anything
# but the bundled string.
ARG VITE_GIT_SHA=

# Build the web package and its dependencies in order
RUN npm run build:web

# --- Runtime stage: nginx serving static files ---
# nginxinc/nginx-unprivileged runs as a non-root user by default and listens
# on 8080 (privileged port 80 requires root, which this image intentionally
# does not run as).
FROM nginxinc/nginx-unprivileged:alpine AS runtime

# Copy the built SPA
COPY --from=builder /app/packages/web/dist/ /usr/share/nginx/html/

# Copy the nginx config template that proxies /v1 and /ws. The image entrypoint
# runs envsubst over /etc/nginx/templates/*.template into /etc/nginx/conf.d before
# nginx starts, so the upstreams are set per environment rather than baked in:
# compose keeps its service names via the defaults below, and the Helm chart injects
# the release-prefixed Service names (ADR-0075).
#
# NGINX_ENVSUBST_FILTER restricts substitution to exactly these two variables.
# Without it, envsubst would also expand anything in the config that happens to
# match an environment variable name, which would silently corrupt nginx's own
# $host / $uri / $scheme style variables.
COPY docker/web/nginx.conf.template /etc/nginx/templates/default.conf.template

ENV API_UPSTREAM=api:8080 \
    GATEWAY_UPSTREAM=gateway:4175 \
    NGINX_ENVSUBST_FILTER="^(API_UPSTREAM|GATEWAY_UPSTREAM)$"

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
