{
  "name": "@chess-platform/persistence",
  "version": "0.1.0",
  "description": "Durable data layer: append-only event store, migrations, repositories, Glicko-2, UUIDv7.",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "default": "./dist/pg/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support/database.d.ts",
      "default": "./dist/test-support/database.js"
    },
    "./test-support/fixtures": {
      "types": "./dist/test-support/fixtures.d.ts",
      "default": "./dist/test-support/fixtures.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test:unit": "node ../../scripts/run-zero-skip.mjs -- node --test --test-concurrency=1 \"dist-test/test/!(*.integration).test.js\"",
    "test:integration:postgres": "node ../../scripts/run-zero-skip.mjs -- node --test --test-concurrency=1 \"dist-test/test/**/*.integration.test.js\"",
    "test": "npm run build:test && npm run test:unit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/pg/migrate-cli.js",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "chess",
    "postgres",
    "event-sourcing",
    "persistence",
    "glicko2"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chess-platform/achievements": "file:../achievements",
    "@chess-platform/anti-cheat": "file:../anti-cheat",
    "@chess-platform/community": "file:../community",
    "@chess-platform/engine": "file:../engine",
    "@chess-platform/game": "file:../game",
    "@chess-platform/learning": "file:../learning",
    "@chess-platform/messaging": "file:../messaging",
    "@chess-platform/search": "file:../search",
    "@chess-platform/social": "file:../social",
    "@chess-platform/studies": "file:../studies",
    "@chess-platform/tournament": "file:../tournament",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0"
  }
}
