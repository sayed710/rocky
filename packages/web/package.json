{
  "name": "@chess-platform/web",
  "version": "0.1.0",
  "private": true,
  "description": "Rookzen web frontend: playable chess board, clocks, game view, lobby, and profile (PWA). Framework-light TypeScript consuming the approved REST + realtime contracts.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test",
    "e2e": "playwright test"
  },
  "keywords": [
    "chess",
    "frontend",
    "board",
    "pwa",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chess-platform/realtime-gateway": "file:../realtime-gateway"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@playwright/test": "^1.40.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.6"
  }
}
