{
  "name": "@chess-platform/api",
  "version": "0.1.0",
  "description": "Stateless REST API & identity service: auth, sessions, RBAC, seeks, ratings, games, OpenAPI.",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    }
  },
  "files": [
    "dist",
    "src",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test:unit": "node ../../scripts/run-zero-skip.mjs -- node --test --test-concurrency=1 \"dist-test/test/**/!(analysis-*smoke|analysis-real-stack|*.integration|*.posix).test.js\"",
    "test:posix": "npm run build:test && node ../../scripts/run-zero-skip.mjs -- node --test --test-concurrency=1 \"dist-test/test/**/*.posix.test.js\"",
    "test:integration:postgres": "npm run build:test && node ../../scripts/run-zero-skip.mjs -- node --test --test-concurrency=1 \"dist-test/test/**/*.integration.test.js\"",
    "test:analysis-smoke": "tsc -p tsconfig.test.json && node ../../scripts/run-zero-skip.mjs -- node --test dist-test/test/analysis-stockfish-smoke.test.js dist-test/test/analysis-fairy-threecheck-smoke.test.js dist-test/test/analysis-real-stack.test.js",
    "test": "npm run build:test && npm run test:unit",
    "test:diagnostics:abort": "tsc -p tsconfig.test.json && node ../../scripts/run-zero-skip.mjs -- node --test dist-test/test/diagnostics/signature-b-preload-abort.diag.js",
    "test:diagnostics:signature-b": "tsc -p tsconfig.test.json && node ./test/diagnostics/run-signature-b-pass.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "openapi": "node dist/scripts/generate-openapi.js",
    "reindex-search": "node dist/scripts/reindex-search.js",
    "serve": "node dist/scripts/serve.js",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "chess",
    "rest",
    "api",
    "identity",
    "rbac",
    "openapi"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chess-platform/achievements": "file:../achievements",
    "@chess-platform/ai-features": "file:../ai-features",
    "@chess-platform/ai-orchestrator": "file:../ai-orchestrator",
    "@chess-platform/anti-cheat": "file:../anti-cheat",
    "@chess-platform/community": "file:../community",
    "@chess-platform/core": "file:../chess-core",
    "@chess-platform/engine": "file:../engine",
    "@chess-platform/game": "file:../game",
    "@chess-platform/learning": "file:../learning",
    "@chess-platform/messaging": "file:../messaging",
    "@chess-platform/persistence": "file:../persistence",
    "@chess-platform/realtime-gateway": "file:../realtime-gateway",
    "@chess-platform/search": "file:../search",
    "@chess-platform/social": "file:../social",
    "@chess-platform/studies": "file:../studies",
    "@chess-platform/tournament": "file:../tournament",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0"
  }
}
