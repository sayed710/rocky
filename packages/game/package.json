{
  "name": "@chess-platform/game",
  "version": "0.1.0",
  "description": "Event-sourced chess game authority: clocks, legality, and durable event log.",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stored-history": {
      "types": "./dist/stored-history.d.ts",
      "require": "./dist/stored-history.js",
      "import": "./dist/stored-history.js",
      "default": "./dist/stored-history.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "chess",
    "event-sourcing",
    "clock",
    "game-server"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chess-platform/core": "file:../chess-core"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
