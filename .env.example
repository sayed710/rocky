# --- Required ---
# HMAC secret for access tokens (must be at least 32 bytes).
# The API and gateway MUST share the same secret so tokens verify across services.
# Generate one with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=dev-secret-change-me-in-production-at-least-32-bytes!!

# --- Postgres ---
POSTGRES_PASSWORD=gambit_dev

# --- Email delivery ---
# Local compose explicitly uses the safe console sender (it prints no token, link, or recipient).
# Production must use EMAIL_PROVIDER=resend and inject RESEND_API_KEY through its secret manager.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=security@example.com
# PUBLIC_WEB_ORIGIN=https://example.com
# EMAIL_TIMEOUT_MS=5000

# Refresh cookies default to Secure. docker-compose.yml explicitly selects false for its localhost
# HTTP stack; a standalone API may do the same only with NODE_ENV=development. Accepted values are
# exactly "true" or "false". Production should leave this unset or set it to true.
# REFRESH_COOKIE_SECURE=true

# --- Redis (optional) ---
# When set, the gateway uses Redis pub/sub for multi-node fanout.
# When absent, the gateway falls back to in-memory pub/sub (single-node).
# REDIS_URL=redis://localhost:6379

# --- Observability (M13, ADR-0028) ---
# Minimum structured-log level for the API/gateway JsonLogger.
# One of: debug | info | warn | error (default info).
# LOG_LEVEL=info

# --- Optional overrides ---
# API host port (default 8080; container always listens on 8080)
# PORT=8080
# Gateway WebSocket host port (default 4175; container always listens on 4175)
# GATEWAY_PORT=4175
# Web frontend host port (default 3000; container always listens on 8080)
# WEB_PORT=3000
# Gateway node identifier (default: random UUID; set for stable identification in multi-node deployments)
# NODE_ID=gateway-1
# Tournament result reporter (ADR-0025, ADR-0152): "1" (the Compose and Helm default) hosts the
# reporter in the gateway (records tournament/arena results and advances rounds; requires
# DATABASE_URL). "0" turns it off on purpose.
# TOURNAMENT_REPORTER=1
# How often (ms) the reporter re-scans running tournaments for new games.
# TOURNAMENT_REPORTER_SCAN_MS=30000

# --- Engine Bot Opponent (M14 inc 13, ADR-0080) ---
# "1" hosts the autonomous engine bot mover in the gateway.
# ENGINE_BOT=1
# Path to Stockfish executable (required when ENGINE_BOT=1, and by the trust worker when
# ANTICHEAT_AUTO_ANALYZE=1). The gateway image sets it.
# STOCKFISH_PATH=/usr/bin/stockfish

# --- Trust worker (ADR-0152) ---
# Bot-timing and anti-cheat analysis of finished games run only in the trust-worker service
# (services/gateway/dist/trust-worker.js). Read by Compose for that service; the gateway refuses
# any value other than "0". Each must be exactly "0" or "1", and at least one "1".
# BOT_AUTO_ANALYZE=1
# ANTICHEAT_AUTO_ANALYZE=1
# How often (ms) the trust worker rescans committed game endings (default 30000).
# TRUST_SCAN_MS=30000

# --- Move Explanation (M15 inc 3, ADR-0115) ---
# Engine-grounded move explanation at POST /v1/ai/move-explanation.
#
# Composed only when an AI provider AND an engine are both configured. With neither, or with only
# one, GET /v1/capabilities reports moveExplanation:false and the route answers 503 — there is no
# fallback provider, and an explanation is never generated without engine output to ground it.
#
# NEVER commit a real key. These are read from the environment at boot and are not logged, returned
# in any response, or included in any error message.
#
# One adapter serves OpenAI, DeepSeek, OpenRouter and a local Ollama; only the base URL differs.
# For a local Ollama set AI_OPENAI_BASE_URL alone and leave the key unset.
# AI_OPENAI_API_KEY=
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=claude-sonnet-4-5
#
# Server-owned ceilings. Each is clamped to the compiled default, so these can only LOWER a limit —
# setting AI_MAX_OUTPUT_TOKENS above 512 has no effect. No request field reaches any of them.
# AI_MAX_OUTPUT_TOKENS=512
# AI_LATENCY_BUDGET_MS=15000
# AI_MAX_FAILOVER_ATTEMPTS=2
# AI_CACHE_ENTRIES=500
# AI_CACHE_TTL_MS=300000

